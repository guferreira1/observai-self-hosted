# ObservAI Self-Hosted environment example
# Copy this file to .env before starting the stack.

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------

OBSERVAI_API_IMAGE=observai/observai-api
OBSERVAI_WEB_IMAGE=observai/observai-web
OBSERVAI_API_VERSION=v0.1.0
OBSERVAI_WEB_VERSION=v0.1.0

# Alternative registries can be used by changing image names.
# OBSERVAI_API_IMAGE=ghcr.io/guferreira1/observai-api
# OBSERVAI_WEB_IMAGE=ghcr.io/guferreira1/observai-web

# -----------------------------------------------------------------------------
# Application URLs and ports
# -----------------------------------------------------------------------------

OBSERVAI_DOMAIN=localhost
OBSERVAI_PUBLIC_URL=http://localhost:3000
OBSERVAI_API_PORT=8080
OBSERVAI_WEB_PORT=3000

# Browser-safe mode: the browser calls the Next.js proxy path and the web
# container forwards requests to OBSERVAI_API_URL over the Docker network.
NEXT_PUBLIC_OBSERVAI_API_URL=/api/observai
OBSERVAI_API_URL=http://observai-api:8080

OBSERVAI_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
NEXT_PUBLIC_APP_NAME=ObservAI
NEXT_PUBLIC_APP_ENV=self-hosted

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

POSTGRES_DB=observai
POSTGRES_USER=observai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
OBSERVAI_DATABASE_DSN=postgres://observai:change-me@postgres:5432/observai?sslmode=disable
# Optional compatibility alias for tooling/scripts that still rely on DATABASE_URL.
DATABASE_URL=postgres://observai:change-me@postgres:5432/observai?sslmode=disable

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

REDIS_PORT=6379
OBSERVAI_REDIS_URL=redis://redis:6379/0
# Optional compatibility alias for tooling/scripts that still rely on REDIS_URL.
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

OBSERVAI_JWT_SECRET=change-me-local-jwt-secret-minimum-32-bytes
OBSERVAI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

OBSERVAI_ENV=self-hosted
OBSERVAI_MODE=local
OBSERVAI_TIMEZONE=Local
OBSERVAI_MIGRATE_ON_START=true
OBSERVAI_MIGRATIONS_DIR=/app/migrations
LOG_LEVEL=info
